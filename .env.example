# === Smart Energy Platform — Environment Variables ===
# Copy this file to .env.local and fill in real values when you connect
# real infrastructure. Nothing here is required to run the demo/simulator.

# --- Data source mode ---
# "simulator" (default) generates realistic demo data in the browser.
# "api" switches services/energy-api.ts to call NEXT_PUBLIC_API_BASE_URL instead.
NEXT_PUBLIC_DATA_SOURCE=simulator

# --- Future real backend (Phase 2+) ---
# Base URL of your backend once ESP32 devices post real measurements here.
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com

# Server-side only secret used by the backend to authenticate IoT devices.
# Never prefix this with NEXT_PUBLIC_ — it must stay out of the client bundle.
DEVICE_AUTH_SECRET=

# --- Database (Phase 2+, used by the backend, not by this Next.js frontend) ---
DATABASE_URL=

# --- AI Energy Assistant (Phase optional) ---
# If set, services/ai-assistant.ts can call a real AI provider instead of the
# built-in rule-based demo analyzer. Leave empty to keep using the demo mode.
AI_PROVIDER_API_KEY=

# --- Auth (Phase 2+) ---
AUTH_SECRET=
